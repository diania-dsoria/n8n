":[[{"node":"Resumir","type":"main","index":0}]]}},"nodeGroups":[],"settings":{"executionOrder":"v1","availableInMCP":true},"staticData":null,"pinData":null,"meta":{"aiBuilderAssisted":true,"builderVariant":"mcp"},"tags":[],"shared":[{"role":"workflow:owner","workflowId":"oHEXLxsNhpjlcyyP","projectId":"qycTVrSpQ4pgtBCR","createdAt":"2026-11-26T09:54:15.568Z","updatedAt":"2026-11-26T09:54:15.568Z"}],"activeVersion":null}