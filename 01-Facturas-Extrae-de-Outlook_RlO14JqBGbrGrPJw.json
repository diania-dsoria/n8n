ntos se descartan) y contamos cuántos hay\nfor (const item of $input.all()) {\n  const soloPDF = {};\n  let i = 0;\n\n  for (const archivo of Object.values(item.binary || {})) {\n    const nombre = (archivo.fileName || '').toLowerCase();\n    if (archivo.mimeType === 'application/pdf' || nombre.endsWith('.pdf')) {\n      soloPDF[`documento_pdf_${i}`] = { ...archivo, mimeType: 'application/pdf' };\n      i++;\n    }\n  }\n\n  item.binary = soloPDF;\n  item.json.numPDFs = i;\n}\n\nreturn $input.all();"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-2832,304],"id":"ec6eb6cb-234b-4e5f-beec-55146c3629d6","name":"Filtramos firmas"},{"parameters":{"jsCode":"const items = $input.all();\nconst resultado = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const binaryData = item.binary;\n\n  if (!binaryData) continue;\n\n  const pdfKey = Object.keys(binaryData).find(key => \n    binaryData[key].mimeType === 'application/pdf'\n  );\n\n  if (pdfKey) {\n    resultado.push({\n      json: {\n        pdf_key: pdfKey,\n        pdf_filename: binaryData[pdfKey].fileName,\n        ...item.json\n      },\n      binary: item.binary\n    });\n  }\n}\n\nif (resultado.length === 0) {\n  throw new Error('No se encontró ningún adjunto PDF en los correos recibidos');\n}\n\nreturn resultado;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-2368,0],"id":"b2979d9b-4f5e-43a4-bfea-0c1d96fb1a3b","name":"Encuentra PDF1"},{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":1}]}},"type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.3,"position":[-3056,16],"id":"39f6f673-77d4-4730-aa16-daed5a6f7fa3","name":"Schedule Trigger"},{"parameters":{"resource":"folderMessage","folderId":{"__rl":true,"value":"AAMkAGRiODNlYmYwLTYyOTgtNGQ5Zi1iMDhkLWU5MzVlYWFkM2FhNAAuAAAAAADyMfjsHXZ5Q7I7yaGL9dFWAQCuMHGnQ0m2So2SM7aA15DUAAAAAAEMAAA=","mode":"list","cachedResultName":"Bandeja de entrada","cachedResultUrl":"https://outlook.office365.com/mail/AAMkAG