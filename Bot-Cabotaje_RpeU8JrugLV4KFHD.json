json.t.btn_menu }}","additionalFields":{"callback_data":"m_menu"}}]}}]},"additionalFields":{"appendAttribution":false}},"id":"e315d3b9-0a11-418b-8fca-a6ef93427f73","name":"Enviar lista","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1568,576],"webhookId":"bbbb8137-b4e9-4971-b223-b2b15f0cf47c","credentials":{"telegramApi":{"id":"BEtcPKucZh7fA2Fj","name":"Diania Conductores"}}},{"parameters":{"operation":"get","dataTableId":{"__rl":true,"mode":"id","value":"mv2EiNX795p1uuHH"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"telefono","keyValue":"={{ $(\"Preparar\").first().json.tel }}"},{"keyName":"estado","keyValue":"borrador"}]},"limit":1},"id":"d05a2688-7c9e-4e9f-a67c-83882db1d065","name":"Buscar borrador","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[1120,816],"alwaysOutputData":true},{"parameters":{"jsCode":"const p = $('Preparar').first().json;\nconst t = p.t || {};\nconst f = $input.first().json || {};\nconst chat = p.chat;\nif (!f.id || f.estado !== 'borrador') return [{ json: { accion: 'sin_borrador', chat: chat } }];\nconst out = { id: f.id, chat: chat, tractora: f.matricula_tractora || '', remolque: f.matricula_remolque || '', palets: f.palets || 0, paso: f.paso, accion: '', mensaje: '' };\nconst resumen = () => String(t.cab_resumen || '').replace('{tractora}', out.tractora).replace('{remolque}', out.remolque).replace('{palets}', String(out.palets));\nconst fin = (accion, mensaje) => { out.accion = accion; out.mensaje = mensaje; return [{ json: out }]; };\nconst norm = (s) => String(s).toUpperCase().replace(/[\\s-]/g, '');\nconst okMat = (s) => /^[A-Z0-9]{4,10}$/.test(s);\nif (p.cb === 'cab_ok') {\n  if (f.paso !== 'confirmar') return [{ json: { accion: 'sin_borrador', chat: chat } }];\n  return fin('confirmar', '');\n}\nconst txt = p.texto;\nif (f.paso === 'tractora') {\n  const m = norm(txt);\n  if (!okMat(m)) return fin('repetir', t.cab_err_matricula + '\\n\\n' + t.cab_pedir_tractora);\n  out.tractora = m; out.paso = 'remolque';\n  return fin('avanzar', t.cab_pedir_remolque);\n}\nif (f.paso === 'remolque') {\n  const m = norm(txt);\n  if (!okMat(m)) return fin('repetir', t.cab_err_matricula + '\\n\\n' + t.cab_pedir_remolque);\n  out.remolque = m; out.paso = 'palets';\n  return fin('avanzar', t.cab_pedir_palets);\n}\nif (f.paso === 'palets') {\n  const n = /^\\d{1,3}$/.test(txt) ? parseInt(txt, 10) : 0;\n  if (n < 1 || n > 66) return fin('repetir', t.cab_err_palets + '\\n\\n' + t.cab_pedir_palets);\n  out.palets = n; out.paso = 'confirmar';\n  return fin('resumen', resumen());\n}\nreturn fin('resumen', resumen());"},"id":"04c9b91f-9a6c-4ba0-b793-dcab8aaf1225","name":"Decidir","type":"n8n-nodes-base.code","typeVersion":2,"position":[1344,816]},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":1},"conditions":[{"leftValue":"={{ $json.accion }}","rightValue":"sin_borrador","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":1},"conditions":[{"leftValue":"={{ $json.accion }}","rightValue":"repetir","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":1},"conditions":[{"leftValue":"={{ $json.accion }}","rightValue":"avanzar","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":1},"conditions":[{"leftValue":"={{ $json.accion }}","rightValue":"resumen","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":1},"conditions":[{"leftValue":"={{ $json.accion }}","rightValue":"confirmar","operator":{"type":"string","operation":"equals"}}],"co