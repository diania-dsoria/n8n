p":"inlineKeyboard","inlineKeyboard":{"rows":[{"row":{"buttons":[{"text":"={{ $(\"Preparar\").first().json.t.btn_menu }}","additionalFields":{"callback_data":"m_menu"}}]}}]},"additionalFields":{"appendAttribution":false}},"credentials":{"telegramApi":{"id":"BEtcPKucZh7fA2Fj","name":"Diania Conductores"}},"webhookId":"c10ea0ad-b26d-4c5e-a230-9882addf2e41"},{"id":"4919be45-905a-4abc-87f2-515705161328","name":"Buscar mis cabotajes","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[1120,576],"parameters":{"resource":"row","operation":"get","dataTableId":{"__rl":true,"mode":"id","value":"mv2EiNX795p1uuHH"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"telefono","condition":"eq","keyValue":"={{ $(\"Preparar\").first().json.tel }}"}]},"returnAll":true},"alwaysOutputData":true},{"id":"f7dc18cd-0dff-4dc9-b030-c1cfc9e15ca4","name":"Formatear lista","type":"n8n-nodes-base.code","typeVersion":2,"position":[1344,576],"parameters":{"jsCode":"const p = $('Preparar').first().json;\nconst t = p.t || {};\nconst filas = $input.all().map(i => i.json).filter(r => r.id && r.estado !== 'borrador');\nfilas.sort((a, b) => String(b.creado || '').localeCompare(String(a.creado || '')));\nconst top = filas.slice(0, 5);\nlet texto;\nif (!top.length) {\n  texto = t.cab_mis_vacio;\n} else {\n  texto = t.cab_mis_titulo + '\\n\\n' + top.map(r => {\n    const est = t['cab_est_' + r.estado] || r.estado;\n    const f = String(r.creado || '').slice(0, 16).replace('T', ' ');\n    return '• ' + f + ' · ' + r.matricula_tractora + ' / ' + r.matricula_remolque + ' · ' + r.palets + ' 📦\\n   ' + est + (r.movimiento ? ' · Mov. ' + r.movimiento : '');\n  }).join('\\n\\n');\n}\nreturn [{ json: { texto: texto } }];"}},{"id":"e315d3b9-0a11-418b-8fca-a6ef93427f73","name":"Enviar lista","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1568,576],"parameters":{"resource":"message","operation":"sendMessage","chatId":"={{ $(\"Preparar\").first().json.chat }}","text":"={{ $json.texto }}","replyMarkup":"inlineKeyboard","inlineKeyboard":{"rows":[{"row":{"buttons":[{"text":"={{ $(\"Preparar\").first().json.t.btn_cab_nuevo }}","additionalFields":{"callback_data":"cab_nuevo"}},{"text":"={{ $(\"Preparar\").first().json.t.btn_menu }}","additionalFields":{"callback_data":"m_menu"}}]}}]},"additionalFields":{"appendAttribution":false}},"credentials":{"telegramApi":{"id":"BEtcPKucZh7fA2Fj","name":"Diania Conductores"}},"webhookId":"bbbb8137-b4e9-4971-b223-b2b15f0cf47c"},{"id":"d05a2688-7c9e-4e9f-a67c-83882db1d065","name":"Buscar borrador","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[1120,816],"parameters":{"resource":"row","operation":"get","dataTableId":{"__rl":true,"mode":"id","value":"mv2EiNX795p1uuHH"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"telefono","condition":"eq","keyValue":"={{ $(\"Preparar\").first().json.tel }}"},{"keyName":"estado","condition":"eq","keyValue":"borrador"}]},"returnAll":false,"limit":1},"alwaysOutputData":true},{"id":"04c9b91f-9a6c-4ba0-b793-dcab8aaf1225","name":"Decidir","type":"n8n-nodes-base.code","typeVersion":2,"position":[1344,816],"parameters":{"jsCode":"const p = $('Preparar').first().json;\nconst t = p.t || {};\nconst f = $input.first().json || {};\nconst chat = p.chat;\nif (!f.id || f.estado !== 'borrador') return [{ json: { accion: 'sin_borrador', chat: chat } }];\nconst out = { id: f.id, chat: chat, tractora: f.matricula_tractora || '', remolque: f.matricula_remolque || '', palets: f.palets || 0, paso: f.paso, accion: '', mensaje: '' };\nconst resumen = () => String(t.cab_resumen || '').replace('{tractora}', out.tractora).replace('{remolque}', out.remolque).replace('{palets}', String(out.palets));\nconst fin = (accion, mensaje) => { out.accion = accion; out.mensaje = mensaje; return [{ json: out }]; };\nconst norm = (s) => String(s).toUpperCase().replace(/[\\s-]/g, '');\nconst okMat = (s) => /^[A-Z0-9]{4,10}$/.test(s);\nif (p.cb === 'cab_ok') {\n  if (f.paso !== 'confirmar') return [{ json: { accion: 'sin_borrador', chat: chat } }];\n  return fin('confirmar', '');\n}\nconst txt = p.texto;\nif (f.paso === 'tractora') {\n  const m = norm(txt);\n  if (!okMat(m)) return fin('repetir', t.cab_err_matricula + '\\n\\n' + t.cab_pedir_tractora);\n  out.tractora = m; out.paso = 'remolque';\n  return fin('avanzar', t.cab_pedir_remolque);\n}\nif (f.paso === 'remolque') {\n  const m = norm(txt);\n  if (!okMat(m)) return fin('repetir', t.cab_err_matricula + '\\n\\n' + t.cab_pedir_remolque);\n  out.remolque = m; out.paso = 'palets';\n  return fin('avanzar', t.cab_pedir_palets);\n}\nif (f.paso === 'palets') {\n  const n = /^\\d{1,3}$/.test(txt) ? parseInt(txt, 10) : 0;\n  if (n < 1 || n > 66) return fin('repetir', t.cab_err_palets + '\\n\\n' + t.cab_pedir_palets);\n  out.palets = n; out.paso = 'confirmar';\n  return fin('resumen', resumen());\n}\nreturn fin('resumen', resumen());"}},{"id":"7dbdc9f7-6137-402c-8ca0-d2b40dd629f0","name":"Resultado","type":"n8n-nodes-base.switch","typeVersion":3.4,"position":[1568,768],"parameters":{"mode":"rules","rules":{"values":[{"outputKey":"sin_borrador","conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"leftValue":"={{ $json.accion }}","rightValue":"sin_borrador","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}},{"outputKey":"repetir","conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"leftValue":"={{ $json.accion }}","rightValue":"repetir","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}},{"outputKey":"avanzar","conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"leftValue":"={{ $json.accion }}","rightValue":"avanzar","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}},{"outputKey":"resumen","conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions"