ia.es","subject":"={{ $json.ok ? \"Galp a Trans2000: importación OK\" : \"ERROR Galp a Trans2000\" }} ({{ $json.formato }}) - {{ $json.empresas.join(\" + \") }}","emailType":"text","message":"=Resultado de la importación de {{ $json.formato }} de Galp en Trans2000\n\nEstado: {{ $json.ok ? \"OK\" : \"ERROR\" }}\nPeriodo: {{ $('Recibe movimientos de Galp').first().json.body.desde ?? \"-\" }} a {{ $('Recibe movimientos de Galp').first().json.body.hasta ?? \"-\" }}\n\nDetalle por fichero:\n{{ $json.detalle.join(\"\\n\") }}\n\nTotal: {{ $json.nuevos }} nuevos, {{ $json.actualizados }} actualizados, {{ $json.incidencias.length }} incidencias\n{{ $json.incidencias.length ? JSON.stringify($json.incidencias, null, 2) : \"\" }}\n{{ $json.errores.length ? \"Errores: \" + $json.errores.join(\" || \") : \"\" }}\n{{ $json.mensajes.length ? \"Mensajes de Trans2000: \" + $json.mensajes.join(\" | \") : \"\" }}","options":{"appendAttribution":false}},"id":"4a5d7706-c9ea-4d48-adbb-c26465d8364e","name":"Enviar resultados por email","type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[1152,400],"webhookId":"d49b89ec-8d0a-41cb-affd-f986894c4814","credentials":{"gmailOAuth2":{"id":"FTWOu8TbMU6c0eQS","name":"DIANIA"}},"onError":"continueRegularOutput"},{"parameters":{"jsCode":"// Con varios ficheros, Trans2000 devuelve { success, info, ficheros: [{ nombre, success, info, nuevos, actualizados, incidencias }] }.\n// Si falla la llamada, n8n entrega el error como un item suelto (sin 'ficheros').\nconst items = $input.all().map((i) => i.json);\nconst raiz = items.length === 1 ? items[0] : null;\nconst porFichero = raiz && Array.isArray(raiz.ficheros) ? raiz.ficheros : null;\nconst resultados = porFichero ?? items;\nconst entrada = $('Recibe movimientos de Galp').first().json.body;\nconst files = entrada.files ?? [];\nconst formato = entrada.formato ?? 'MOVIMIENTOS';\nconst num = (campo) => resultados.reduce((s, r) => s + (Number(r[campo]) || 0), 0);\nconst incidencias = resultados.flatMap((r) => (Array.isArray(r.incidencias) ? r.incidencias : []));\nconst detalleError = (r) => r.info ?? r.details?.body?.respuesta?.info ?? r.details?.description ?? null;\nconst errores = resultados\n  .filter((r) => r.success !== true)\n  .map((r) => [r.nombre, r.error?.message ?? (typeof r.error === 'string' ? r.error : null), detalleError(r)].filter(Boolean).join(' | ') || 'Respuesta inesperada de Trans2000');\nif (porFichero && raiz.success !== true && !errores.length) errores.push(raiz.info ?? 'Trans2000 ha rechazado la importación');\nconst ok = resultados.length > 0 && errores.length === 0;\nconst resultadoDe = (f) => resultados.find((r) => r.nombre === f.nombre || r.fichero === f.nombre);\nconst detalle = files.map((f) => {\n  const base = formato === 'FACTURAS'\n    ? `${f.empresa}: factura ${f.factura ?? '?'} (${f.fecha_factura || 'sin fecha'})`\n    : `${f.empresa}: ${f.movimientos ?? '?'} movimientos`;\n  const r = resultadoDe(f);\n  return r ? `${base} -> ${r.nuevos ?? '-'} nuevos, ${r.actualizados ?? '-'} actualizados, ${Array.isArray(r.incidencias) ? r.incidencias.length : 0} incidencias` : base;\n});\nreturn [{\n  json: {\n    ok,\n    formato,\n    empresas: [...new Set(files.map((f) => f.empresa))],\n    ficheros: files.map((f) => f.nombre),\n    detalle,\n    nuevos: num('nuevos'),\n    actualizados: num('actualizados'),\n    incidencias,\n    errores,\n    mensajes: [...new Set([raiz?.info, ...resultados.map((r) => r.info)].filter(Boolean))],\n  },\n}];"},"id":"ef421399-8b65-4960-ba27-1411183065fa","name":"Resumir respuesta","type":"n8n-nodes-base.code","typeVersion":2,"position":[848,304]}],"connections":{"Recibe movimientos de Galp":{"main":[[{"node":"Enviar a API Trans2000","type":"main","index":0}]]},"Enviar a API Trans2000":{"main":[[{"node":"Resumir respuesta","type":"main","index":0}]]},"Resumir respuesta":{"main":[[{"node":"Responder al webhook","type":"main","index":0},{"node":"Enviar resultados por email","type":"main","index":0}]]}},"n