{"id":"luYbyNezufU4xpfZ","name":"TEMP lectura formulas planning (solo lectura)","active":false,"activeVersionId":null,"createdAt":"2026-11-24T14:09:57.126Z","updatedAt":"2026-11-24T14:10:56.000Z","isArchived":true,"versionId":"e180d437-70d7-487f-861f-fa0804751c14","triggerCount":0,"nodes":[{"id":"18001c11-6717-42de-90d0-db4ef7f76ff6","name":"Inicio","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[0,96],"parameters":{}},{"id":"d1f3ff93-3885-4392-9865-d6393a6a6095","name":"Leer formulas","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[224,0],"parameters":{"method":"GET","url":"https://sheets.googleapis.com/v4/spreadsheets/1TuRRe-1VqS_dHTrR_oebfAU9Rp1Sbss9foVR6YcZUO4/values:batchGet?ranges=%2748-26%27!A1:P200&ranges=%2702-26%27!A1:P200&ranges=DATOS!A1:W200&valueRenderOption=FORMULA","authentication":"predefinedCredentialType","nodeCredentialType":"googleSheetsOAuth2Api"},"credentials":{"googleSheetsOAuth2Api":{"id":"GfuU4Tm8szf1Olwt","name":"Google Sheets account"}}},{"id":"ea3f4587-2bd7-4f49-934e-6173bc8c1ed2","name":"Resumir formulas","type":"n8n-nodes-base.code","typeVersion":2,"position":[448,0],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const body = $input.first().json;\nconst out = [];\nfor (const vr of body.valueRanges) {\n  const rows = vr.values || [];\n  const formulas = [];\n  let noVacias = 0;\n  rows.forEach((row, i) => row.forEach((v, j) => {\n    if (v !== '' && v !== null && v !== undefined) noVacias++;\n    if (typeof v === 'string' && v.charAt(0) === '=') {\n      formulas.push({ c: String.fromCharCode(65 + j) + (i + 1), f: v });\n    }\n  }));\n  const patrones = {};\n  formulas.forEach(x => {\n    const col = x.c.replace(/[0-9]/g, '');\n    const p = col + ': ' + x.f.replace(/[0-9]+/g, '#');\n    if (!patrones[p]) patrones[p] = { n: 0, ejemplo: x.c + ' ' + x.f };\n    patrones[p].n++;\n  });\n  out.push({ range: vr.range, filas: rows.length, celdasNoVacias: noVacias, formulas: formulas.length, patrones });\n}\nreturn [{ json: { resumen: out } }];"}},{"id":"79a1b125-adae-4941-adf4-0df15b1e7793","name":"Leer contenido","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[224,192],"parameters":{"method":"GET","url":"https://sheets.googleapis.com/v4/spreadsheets/1TuRRe-1VqS_dHTrR_oebfAU9Rp1Sbss9foVR6YcZUO4/values:batchGet?ranges=%2702-26%27!A1:K70&ranges=%2748-26%27!A81:E200&valueRenderOption=FORMATTED_VALUE","authentication":"predefinedCredentialType","nodeCredentialType":"googleSheetsOAuth2Api"},"credentials":{"googleSheetsOAuth2Api":{"id":"GfuU4Tm8szf1Olwt","name":"Google Sheets account"}}}],"connections":{"Inicio":{"main":[[{"node":"Leer formulas","type":"main","index":0},{"node":"Leer contenido","type":"main","index":0}]]},"Leer formulas":{"main":[[{"node":"Resumir formulas","type":"main","index":0}]]}},"nodeGroups":[],"settings":{"executionOrder":"v1","availableInMCP":true},"staticData":null,"pinData":null,"meta":{"aiBuilderAssisted":true,"builderVariant":"mcp"},"tags":[],"shared":[{"role":"workflow:owner","workflowId":"luYbyNezufU4xpfZ","projectId":"qycTVrSpQ4pgtBCR","createdAt":"2026-11-24T14:09:57.127Z","updatedAt":"2026-11-24T14:09:57.127Z"}],"activeVersion":null}